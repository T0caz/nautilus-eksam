{
  "name": "nautilus-exam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "setup": "node scripts/setup.mjs",
    "admin": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs"
  }
}
